---
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Nav from '../components/Nav.astro';
import Section from '../components/Section.astro';
import { loadConfig, resolveLabels } from '../config';
import Layout from '../layouts/Layout.astro';
import { buildContactLinks } from '../lib/contact-links';
import { buildFooter } from '../lib/footer';
import { buildNavItems } from '../lib/nav-items';
import { buildSections } from '../lib/page-sections';
import { SECTION_REGISTRY } from '../sections/registry';

const cv = loadConfig();
const labels = resolveLabels(cv);
const sections = buildSections(cv, labels, SECTION_REGISTRY);
const navItems = buildNavItems(sections, labels);
const contacts = buildContactLinks(cv.contacts);
// Единственный побочный эффект страницы: год сборки читается здесь, дальше он аргумент.
const footer = buildFooter({
  name: cv.name,
  year: new Date().getFullYear(),
  credit: labels.footerCredit
});
---

<Layout lang={cv.lang} title={cv.name}>
  {navItems.length > 0 && (
    <a
      href="#main"
      class="link bg-background sr-only focus:not-sr-only focus:block focus:py-2 print:hidden"
    >
      {labels.skipLink}
    </a>
  )}
  <Hero
    name={cv.name}
    position={cv.position}
    contactsTitle={labels.sections.contacts.title}
    contacts={contacts}
    printLabel={labels.pdfButton ?? undefined}
  />
  {navItems.length > 0 && <Nav items={navItems} />}
  {sections.length > 0 && (
    <main id="main">
      {sections.map(({ id, title, component: Content }) => (
        <Section id={id} title={title}>
          <Content cv={cv} />
        </Section>
      ))}
    </main>
  )}
  {cv.footer.show && <Footer {...footer} />}
</Layout>
