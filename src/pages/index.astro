---
import '../styles/global.css';
import { loadConfig } from '../config';

// Временно: показываем имя и должность из конфига, заглушку заменит фича 2.
const cv = loadConfig();
---

<html lang={cv.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{cv.name}</title>
  </head>
  <body class="flex min-h-screen flex-col items-center justify-center gap-2">
    <h1 class="text-4xl font-bold tracking-tight">{cv.name}</h1>
    <p class="text-muted-foreground font-mono text-sm">{cv.position}</p>
  </body>
</html>
