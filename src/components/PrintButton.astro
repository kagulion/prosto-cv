---
interface Props {
  readonly label: string;
}

const { label } = Astro.props;
---

<div class="mt-4 print:hidden">
  <button
    type="button"
    hidden
    data-print-button
    class="link cursor-pointer transition-[transform,text-decoration-color] duration-150 ease-out active:scale-[0.97]"
  >
    {label}
  </button>
</div>

<script>
  // Единственный клиентский скрипт страницы. Без JS кнопка остаётся скрытой.
  const button = document.querySelector<HTMLButtonElement>('[data-print-button]');
  if (button) {
    button.hidden = false;
    button.addEventListener('click', () => window.print());
  }
</script>
