---
import type { NavItem } from '../lib/nav-items';

interface Props {
  readonly items: readonly NavItem[];
}

const { items } = Astro.props;
---

<!--
  Содержание справа от колонки: рамка на всю высоту `main`, внутри липкий список.
  Верх выровнен по заголовку первой секции (`pt-[86px]`), при прокрутке список липнет к `top-[94px]`.
  Правый край `main` отстоит от края колонки на 1.5rem (`sm:px-6`): зазор 6rem до колонки даёт `ml-30`.
  Влезает с `xl`, ниже скрыто.
-->
<nav
  data-nav
  class="absolute inset-y-0 left-full ml-30 hidden w-44 pt-[86px] xl:block print:hidden"
>
  <div class="sticky top-[94px]">
    <ul class="group/list border-border flex flex-col gap-y-0 border-l">
      {items.map(({ id, label }) => (
        <li class="before:bg-foreground has-[[aria-current=location]]:before:scale-y-100 relative min-w-0 wrap-anywhere before:absolute before:inset-y-0 before:-left-px before:w-px before:scale-y-0 before:transition-transform before:duration-200 before:ease-out">
          <a
            title={label}
            class="text-muted-foreground hover:text-foreground aria-[current=location]:text-foreground focus-visible:outline-foreground line-clamp-2 rounded-sm py-1 pl-4 text-[13px] transition-[color,opacity] duration-150 group-hover/list:opacity-50 hover:opacity-100! ease-out focus-visible:outline-2 focus-visible:outline-offset-2"
            href={`#${id}`}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  // Подсветка текущей секции в содержании. Активной считается секция, верх которой
  // ближе всего к линии на пятой части высоты экрана; внизу страницы это самая нижняя секция.
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const links = nav ? [...nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')] : [];
  const targets = links.flatMap((link) => {
    const target = document.getElementById(link.hash.slice(1));
    return target ? [{ link, target }] : [];
  });

  if (targets.length > 0) {
    let frame = 0;
    const update = () => {
      frame = 0;
      const line = window.innerHeight * 0.2;
      const atBottom =
        window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      const tops = targets.map((entry) => ({
        ...entry,
        top: entry.target.getBoundingClientRect().top
      }));
      const pool = atBottom ? tops : tops.filter(({ top }) => top <= line);
      const current = pool.reduce<(typeof tops)[number] | undefined>(
        (best, entry) => (best === undefined || entry.top > best.top ? entry : best),
        undefined
      );
      for (const { link } of targets) {
        if (current?.link === link) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
    };
    const schedule = () => {
      if (frame === 0) frame = requestAnimationFrame(update);
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
  }
</script>
