---
import brands from '@iconify-json/fa6-brands/icons.json';
import Mail from '@lucide/astro/icons/mail';
import Smartphone from '@lucide/astro/icons/smartphone';
import type { ContactKind } from '../lib/contact-links';

interface Props {
  readonly kind: ContactKind;
}

const BASIC = { phone: Smartphone, email: Mail } as const;
const BRANDS = { telegram: 'telegram', github: 'github', linkedin: 'linkedin' } as const;

const { kind } = Astro.props;
const Basic = kind in BASIC ? BASIC[kind as keyof typeof BASIC] : undefined;
const brand = kind in BRANDS ? BRANDS[kind as keyof typeof BRANDS] : undefined;
const brandIcon = brand === undefined ? undefined : brands.icons[brand];
const brandBody = brandIcon?.body;
// У части иконок своя ширина (telegram, github шире общей): иначе viewBox обрезает их справа.
const brandWidth = brandIcon && 'width' in brandIcon ? brandIcon.width : brands.width;
---

{Basic !== undefined && <Basic class="size-[18px]" aria-hidden="true" />}
{brandBody !== undefined && (
  <svg
    class="size-[18px] text-zinc-700"
    viewBox={`0 0 ${brandWidth} ${brands.height}`}
    fill="currentColor"
    aria-hidden="true"
    set:html={brandBody}
  />
)}
