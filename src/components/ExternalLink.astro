---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import { displayUrl } from '../lib/links';

interface Props {
  readonly href: string;
}

const { href } = Astro.props;
---

<a class="link" href={href}>
  <slot />
  <ArrowUpRight
    class="ml-0.5 inline-block size-[0.9em] align-[-0.1em] print:hidden"
    aria-hidden="true"
  />
</a>
<span class="hidden wrap-anywhere print:inline"> ({displayUrl(href)})</span>
