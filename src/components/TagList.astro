---
interface Props {
  readonly items: readonly string[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <ul class="mt-2 flex flex-wrap gap-2">
    {items.map((item) => (
      <li class="min-w-0 rounded-md border bg-secondary px-2 py-0.5 text-sm wrap-anywhere text-secondary-foreground">
        {item}
      </li>
    ))}
  </ul>
)}
