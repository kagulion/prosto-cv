---
import type { ContactItem } from '../lib/contact-links';
import { CONTACTS_ID, splitParagraphs } from '../lib/page-sections';
import type { PhotoView } from '../lib/photo';
import ContactIcon from './ContactIcon.astro';
import PrintButton from './PrintButton.astro';

interface Props {
  readonly name: string;
  readonly position: string;
  /** Город в одном блоке с именем и специализацией. Нет значения, значит строки нет. */
  readonly location?: string;
  /** Текст «О себе» под специализацией, без заголовка. Нет значения, значит блока нет. */
  readonly about?: string;
  readonly contactsTitle: string;
  readonly contacts: readonly ContactItem[];
  /** Фото справа от имени. Нет значения, значит нет ни картинки, ни заглушки. */
  readonly photo?: PhotoView;
  /** Подпись кнопки печати. Нет значения, значит кнопки и скрипта нет. */
  readonly printLabel?: string;
}

const { name, position, location, about, contactsTitle, contacts, photo, printLabel } = Astro.props;
const paragraphs = splitParagraphs(about ?? '');
const titleId = `${CONTACTS_ID}-title`;
---

<header class="pt-12 sm:pt-16 print:py-4">
  <div class="flex items-start justify-between gap-4 sm:gap-6">
    <div class="min-w-0">
      <div class="font-serif font-normal tracking-tight">
        <h1 class="text-2xl">{name}</h1>
        <p class="mt-0.5 text-lg">
          {position}
          {location !== undefined && (
            <>
              <span aria-hidden="true" class="mx-4 inline-block size-1 bg-current align-middle" />
              {location}
            </>
          )}
        </p>
      </div>
      {paragraphs.length > 0 && (
        <div class="mt-14 space-y-4 font-serif text-lg leading-relaxed text-pretty">
          {paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      )}
    </div>
    {photo !== undefined && (
      <img
        src={photo.src}
        width={photo.width}
        height={photo.height}
        alt={photo.alt}
        loading="eager"
        class="size-16 shrink-0 rounded-lg object-cover sm:size-24"
      />
    )}
  </div>
  <section id={CONTACTS_ID} aria-labelledby={titleId} class="mt-14">
    <h2 id={titleId} class="sr-only">
      {contactsTitle}
    </h2>
    <ul class="flex flex-wrap gap-2 print:gap-x-6 print:gap-y-2">
      {contacts.map(({ kind, display, href }) => (
        <li class="min-w-0 wrap-anywhere" title={display}>
          {href === undefined ? (
            <span class="icon-chip">
              <span class="inline-flex print:hidden">
                <ContactIcon kind={kind} />
              </span>
              <span class="sr-only print:not-sr-only">{display}</span>
            </span>
          ) : (
            <a class="icon-button" href={href}>
              <span class="inline-flex print:hidden">
                <ContactIcon kind={kind} />
              </span>
              <span class="sr-only print:not-sr-only">{display}</span>
            </a>
          )}
        </li>
      ))}
      {printLabel !== undefined && <PrintButton label={printLabel} />}
    </ul>
  </section>
</header>
