---
import type { LinkItem } from '../lib/contact-links';
import { CONTACTS_ID, splitParagraphs } from '../lib/page-sections';
import ContactIcon from './ContactIcon.astro';
import PrintButton from './PrintButton.astro';

interface Props {
  readonly name: string;
  readonly position: string;
  /** Город в одном блоке с именем и специализацией. Нет значения, значит строки нет. */
  readonly location?: string;
  /** Текст «О себе» под специализацией, без заголовка. */
  readonly about: string;
  readonly contactsTitle: string;
  readonly contacts: readonly LinkItem[];
  /** Подпись кнопки печати. Нет значения, значит кнопки и скрипта нет. */
  readonly printLabel?: string;
}

const { name, position, location, about, contactsTitle, contacts, printLabel } = Astro.props;
const paragraphs = splitParagraphs(about);
const titleId = `${CONTACTS_ID}-title`;
---

<header class="pt-12 sm:pt-16 print:py-4">
  <div class="flex items-start justify-between gap-4 sm:gap-6">
    <div class="min-w-0">
      <div class="font-serif font-normal tracking-tight">
        <h1 class="text-2xl font-medium">{name}</h1>
        <p class="mt-0.5 flex flex-col text-lg sm:flex-row sm:flex-wrap sm:items-baseline sm:gap-x-4">
          <span>{position}</span>
          {location !== undefined && (
            <span class="sm:flex sm:items-baseline sm:gap-x-4">
              <span aria-hidden="true" class="hidden size-1 bg-current sm:inline-block" />
              {location}
            </span>
          )}
        </p>
      </div>
      {paragraphs.length > 0 && (
        <div class="mt-14 space-y-4 font-serif text-lg leading-relaxed text-pretty">
          {paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      )}
    </div>
  </div>
  <section id={CONTACTS_ID} aria-labelledby={titleId} class="mt-14">
    <h2 id={titleId} class="sr-only">
      {contactsTitle}
    </h2>
    <ul class="flex flex-col items-start gap-2 sm:flex-row sm:flex-wrap print:gap-x-6 print:gap-y-2">
      {contacts.map(({ kind, display, href }) => (
        <li class="max-w-full min-w-0 wrap-anywhere" title={display}>
          <a
            class="icon-button max-sm:h-auto max-sm:min-h-9 max-sm:justify-start max-sm:gap-2 max-sm:px-2.5 max-sm:py-1.5"
            href={href}
          >
            <span class="inline-flex print:hidden">
              <ContactIcon kind={kind} />
            </span>
            <span class="sr-only max-sm:not-sr-only max-sm:min-w-0 max-sm:text-sm print:not-sr-only">
              {display}
            </span>
          </a>
        </li>
      ))}
      {printLabel !== undefined && <PrintButton label={printLabel} />}
    </ul>
  </section>
</header>
