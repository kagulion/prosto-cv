---
import type { Cv } from '../config';
import TagList from '../components/TagList.astro';

interface Props {
  readonly cv: Cv;
}

const { cv } = Astro.props;
const projects = cv.projects ?? [];
---

<ul class="space-y-6">
  {projects.map(({ name, url, tag, description, tech }) => (
    <li>
      <h3 class="font-semibold">
        {url !== undefined ? (
          <a class="link" href={url}>
            {name}
          </a>
        ) : (
          name
        )}
      </h3>
      {tag !== undefined && <p class="text-muted-foreground">{tag}</p>}
      {description !== undefined && <p>{description}</p>}
      <TagList items={tech ?? []} />
    </li>
  ))}
</ul>
