---
import type { Cv } from '../config';
import { joinFilled } from '../lib/text';

interface Props {
  readonly cv: Cv;
}

const { cv } = Astro.props;
const entries = (cv.education ?? []).map(({ institution, degree, field, period }) => ({
  institution,
  qualification: joinFilled([degree, field], ', '),
  period
}));
---

<ul class="space-y-6">
  {entries.map(({ institution, qualification, period }) => (
    <li>
      <h3 class="font-semibold">{institution}</h3>
      {qualification !== '' && <p>{qualification}</p>}
      {period !== undefined && <p class="text-muted-foreground">{period}</p>}
    </li>
  ))}
</ul>
