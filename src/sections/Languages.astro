---
import type { Cv } from '../config';
import { languageLine } from '../lib/languages';

interface Props {
  readonly cv: Cv;
}

const { cv } = Astro.props;
// Название выделяем отдельно, остаток строки («: уровень (пояснение)») берём из той же сборки.
const lines = (cv.languages ?? []).map((language) => ({
  name: language.name,
  rest: languageLine(language).slice(language.name.length)
}));
---

<ul class="space-y-1 text-sm">
  {lines.map(({ name, rest }) => (
    <li>
      <span class="font-medium">{name}</span>
      {rest}
    </li>
  ))}
</ul>
